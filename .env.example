# ========================================================================
# SpeakUp AI Coach Server Configuration
# ========================================================================
# SECURITY WARNING:
# Never commit real API keys to version control!
# Never prefix secret keys with VITE_ (Vite exposes VITE_* to the browser bundle).
#
# Create a local copy named `.env` or `.env.local` to store your secret key.
# ========================================================================

# Required: Your AI Provider Secret API Key
# Supported providers:
# - OpenAI (sk-...) -> Enables OpenAI Realtime WebRTC API + HD Studio Voices (nova, alloy, shimmer, echo, onyx)
# - Groq (gsk_...) -> Ultra-fast text AI + Neural Voice engine
# - Google Gemini (AIzaSy...) -> New Gemini 2.0 Flash / 2.5 Flash native API (Free tier: https://aistudio.google.com)
# - OpenRouter (sk-or-...)
# - Demo mode: Set AI_API_KEY=demo to test locally without an API key!
AI_API_KEY=your_secret_key_here

# Optional: Google Gemini API Key (or set AI_API_KEY directly above)
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override Text Chat Model Name (e.g. gemini-2.0-flash, gpt-4o-mini, llama-3.3-70b-versatile)
# AI_MODEL=gemini-2.0-flash

# Optional: Custom OpenAI-compatible endpoint URL (e.g. https://api.groq.com/openai/v1)
# AI_BASE_URL=https://api.openai.com/v1

# Optional: ElevenLabs API Key for ultra-realistic voice cloning
# ELEVENLABS_API_KEY=your_elevenlabs_key_here
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Server Port (when running `npm run server` or `node server.js`)
PORT=3001

# ========================================================================
# Authentication & Database Security Configuration
# ========================================================================
# Secret key used for signing HMAC-SHA256 JWT tokens
JWT_SECRET=speakup_jwt_production_secret_key_change_in_production_987654321

# SQLite Database storage path (defaults to data/speakup.db)
DATABASE_PATH=data/speakup.db

# ========================================================================
# MySQL Database Configuration (Optional)
# Set DB_TYPE=mysql to use MySQL instead of SQLite.
# ========================================================================
DB_TYPE=sqlite
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=speakup_db

# Optional: Full MySQL connection string
# MYSQL_URL=mysql://root:password@localhost:3306/speakup_db

